# Copy to .env and fill in. Never commit the filled-in file.
# On GCP the service account provides credentials automatically; locally, point
# GOOGLE_APPLICATION_CREDENTIALS at a key file (or run
# `gcloud auth application-default login`).

# --- GCP / Vertex AI (LLM + Vision CAPTCHA solver) ---
GCP_PROJECT_ID=nuveroai
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- Knowledge base (local RAG) ---
VIT_KB_DIR=./vit_knowledge_base
RAG_TOP_K=6

# --- Telegram bot (optional) ---
# Create a bot with @BotFather, paste the token here. The webhook URL is your
# public https origin + /telegram/webhook ; the secret is any random string
# (e.g. `openssl rand -hex 16`) — Telegram echoes it back on every update.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# --- Diagnostics ---
# Set to 1 to expose GET /api/debug/vtop?user_id=... (dumps raw VTOP responses).
VITOPIA_DEBUG=

# Persist VTOP credentials (base64) to disk for silent re-login across restarts.
# Leave OFF for shared/public deployments — users just re-login (fast, auto-CAPTCHA).
VITOPIA_STORE_CREDENTIALS=

# --- Server ---
PORT=8000
